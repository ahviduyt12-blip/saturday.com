# ============================================================
#   Saturday Platform — .gitignore
# ============================================================

# Environment variables (⚠️ কখনো commit করবেন না)
.env
.env.local
.env.production

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files (sensitive user data)
database/data/*.db
database/data/*.db.idx

# Uploaded files
public/images/avatars/*
!public/images/avatars/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Build
dist/
build/
