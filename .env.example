# ============================================================
#   Saturday Platform — Environment Example File
#   এই ফাইলটি কপি করে .env নাম দিন এবং নিজের মান দিন
#   cp .env.example .env
# ============================================================


# ─── SERVER ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=https://saturday-com.onrender.com
#------------------------
/*
http://localhost:3000
*/

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here_minimum_64_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d


# ─── ADMIN ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_PHONE=01XXXXXXXXX
ADMIN_EMAIL=admin@yourdomain.com


# ─── DATABASE ───────────────────────────────────────────────
DB_PATH=./database/data
DB_USERS=./database/data/users.db
DB_TASKS=./database/data/tasks.db
DB_ACTIVATIONS=./database/data/activations.db
DB_WITHDRAWALS=./database/data/withdrawals.db
DB_VIP=./database/data/vip.db
DB_COMMISSIONS=./database/data/commissions.db
DB_ANNOUNCEMENTS=./database/data/announcements.db
DB_COMPLETIONS=./database/data/completions.db


# ─── PAYMENT ────────────────────────────────────────────────
BKASH_AGENT_NUMBER=01XXXXXXXXX
NAGAD_AGENT_NUMBER=01XXXXXXXXX
ACTIVATION_COST=100
REFERRAL_COMMISSION=20
WITHDRAW_MIN=300
WITHDRAW_MAX=1500
VIP1_PRICE=300
VIP2_PRICE=400
VIP3_PRICE=500
VIP4_PRICE=700
VIP0_DAILY_TASKS=1
VIP1_DAILY_TASKS=2
VIP2_DAILY_TASKS=3
VIP3_DAILY_TASKS=4
VIP4_DAILY_TASKS=6


# ─── SECURITY ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=*
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=604800000


# ─── UPLOAD ─────────────────────────────────────────────────
UPLOAD_PATH=./public/images/avatars
UPLOAD_MAX_SIZE=2097152


# ─── SUPPORT ────────────────────────────────────────────────
SUPPORT_WHATSAPP_PASSWORD=01XXXXXXXXX
SUPPORT_WHATSAPP_WITHDRAW=01XXXXXXXXX
SUPPORT_WHATSAPP_ACTIVATION=01XXXXXXXXX
OFFICIAL_WHATSAPP=01XXXXXXXXX
OFFICIAL_TELEGRAM=https://t.me/your_channel
OFFICIAL_YOUTUBE=https://youtube.com/@your_channel


# ─── RATE LIMITING ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
