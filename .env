# ============================================================
#   Saturday Platform — Environment Configuration
#   ⚠️  এই ফাইলটি কখনো GitHub বা Public জায়গায় শেয়ার করবেন না
#   ⚠️  .gitignore এ .env যোগ করুন
# ============================================================


# ─── SERVER ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000


# ─── JWT (JSON Web Token) ────────────────────────────────────
# ⚠️  Production এ এই key পরিবর্তন করুন (কমপক্ষে ৬৪ character)
JWT_SECRET=saturday_jwt_super_secret_key_2024_change_in_production_minimum_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=saturday_refresh_super_secret_key_2024_change_this_too_in_production
JWT_REFRESH_EXPIRES_IN=30d


# ─── ADMIN CREDENTIALS ──────────────────────────────────────
# ⚠️  Production এ অবশ্যই পরিবর্তন করুন
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PHONE=01718158600
ADMIN_EMAIL=admin@saturday.com


# ─── DATABASE (NeDB — File Based) ───────────────────────────
DB_PATH=./database/data
DB_USERS=./database/data/users.db
DB_TASKS=./database/data/tasks.db
DB_ACTIVATIONS=./database/data/activations.db
DB_WITHDRAWALS=./database/data/withdrawals.db
DB_VIP=./database/data/vip.db
DB_COMMISSIONS=./database/data/commissions.db
DB_ANNOUNCEMENTS=./database/data/announcements.db
DB_COMPLETIONS=./database/data/completions.db


# ─── PAYMENT CONFIGURATION ──────────────────────────────────
# bKash Agent Number
BKASH_AGENT_NUMBER=01718158600
# Nagad Agent Number
NAGAD_AGENT_NUMBER=01718158600

# Account Activation Cost (BDT)
ACTIVATION_COST=100

# Referral Commission Amount (BDT)
REFERRAL_COMMISSION=20

# Withdrawal Limits (BDT)
WITHDRAW_MIN=300
WITHDRAW_MAX=1500

# VIP Prices (BDT)
VIP1_PRICE=300
VIP2_PRICE=400
VIP3_PRICE=500
VIP4_PRICE=700

# VIP Daily Task Limits
VIP0_DAILY_TASKS=1
VIP1_DAILY_TASKS=2
VIP2_DAILY_TASKS=3
VIP3_DAILY_TASKS=4
VIP4_DAILY_TASKS=6


# ─── BCRYPT ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10


# ─── CORS ───────────────────────────────────────────────────
# Development এ সব origin allow করা হয়েছে
# Production এ নির্দিষ্ট domain দিন
CORS_ORIGIN=*
# Production Example:
# CORS_ORIGIN=https://yourdomain.com


# ─── SESSION ────────────────────────────────────────────────
SESSION_SECRET=saturday_session_secret_key_2024_change_in_production
SESSION_MAX_AGE=604800000


# ─── FILE UPLOAD ────────────────────────────────────────────
UPLOAD_PATH=./public/images/avatars
UPLOAD_MAX_SIZE=2097152


# ─── CONTACT & SUPPORT ──────────────────────────────────────
SUPPORT_WHATSAPP_PASSWORD=01755558880
SUPPORT_WHATSAPP_WITHDRAW=01958628880
SUPPORT_WHATSAPP_ACTIVATION=01384599650
OFFICIAL_WHATSAPP=01718158600
OFFICIAL_TELEGRAM=https://t.me/saturday_official
OFFICIAL_YOUTUBE=https://youtube.com/@saturday_official


# ─── RATE LIMITING ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100


# ─── PRODUCTION ONLY ────────────────────────────────────────
# (নিচের লাইনগুলো শুধু production এ ব্যবহার করুন)
# NODE_ENV=production
# BASE_URL=https://yourdomain.com
# CORS_ORIGIN=https://yourdomain.com
# JWT_SECRET=your_very_long_random_production_secret_here
# ADMIN_PASSWORD=your_strong_admin_password_here
